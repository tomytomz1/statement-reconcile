{
  "name": "statement-reconcile",
  "version": "1.0.0",
  "private": true,
  "description": "Statement Reconcile — convert PDF bank and credit-card statements to Excel and CSV, with deterministic reconciliation before payment.",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/copy-pdf-worker.ts --strict && next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --write \"src/app/(site)/[slug]/page.tsx\" src/components/site/statement-example.tsx src/lib/seo/statement-example.ts && node scripts/ci-format-echo.cjs && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "fixtures:generate": "tsx scripts/generate-fixtures.ts",
    "benchmark:synthetic": "tsx benchmarks/runners/index.ts",
    "setup:check": "tsx scripts/setup-check.ts",
    "doctor": "tsx scripts/doctor.ts",
    "price:preflight": "tsx scripts/price-preflight.ts",
    "funnel:variants": "tsx scripts/funnel-variant-report.ts",
    "audit:seo": "tsx scripts/audit-seo.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm benchmark:synthetic && pnpm build",
    "verify:release": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm benchmark:synthetic && pnpm audit:seo && pnpm build && pnpm test:e2e",
    "postinstall": "tsx scripts/copy-pdf-worker.ts"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "next": "16.3.2",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "fast-check": "^4.9.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
