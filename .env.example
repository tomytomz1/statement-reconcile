# Application
APP_ENV=
NEXT_PUBLIC_SITE_URL=

# Stripe (server). Never commit real keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Seals the extraction result the browser holds between preview and paid export.
EXPORT_SEAL_SECRET=

# Parser. `none` = deterministic-only. Set PARSER_DETERMINISTIC_ONLY=1 to ignore a configured provider.
PARSER_PROVIDER=
PARSER_API_KEY=
PARSER_MODEL=
PARSER_BASE_URL=
PARSER_TIMEOUT_MS=
PARSER_DETERMINISTIC_ONLY=
# Required in production if a parser provider is configured. Without both, the provider is treated as off.
PARSER_ZERO_DATA_RETENTION=
PARSER_DISABLE_TRAINING=

# Rate limit. Production should use upstash plus URL and token. `memory` is local-only.
RATE_LIMIT_PROVIDER=
RATE_LIMIT_URL=
RATE_LIMIT_TOKEN=

# Test-only payment bypass. Requires APP_ENV=test and a non-production NODE_ENV.
E2E_MOCK_PAYMENTS=

# Public offer and limits (optional; defaults live in src/config/site.ts)
NEXT_PUBLIC_PRICE_USD=
NEXT_PUBLIC_MAX_PAGES=
NEXT_PUBLIC_MAX_FILE_SIZE_MB=
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_PRODUCT_VERSION=

# Legal entity — set before launch. Doctor reports the names if they are still unset.
NEXT_PUBLIC_LEGAL_BUSINESS_NAME=
NEXT_PUBLIC_LEGAL_JURISDICTION=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SECURITY_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=

# Analytics. Leave empty to keep analytics off.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_KEY=
NEXT_PUBLIC_ANALYTICS_HOST=
NEXT_PUBLIC_TWITTER_HANDLE=
NEXT_PUBLIC_ENABLE_ANALYTICS=

# Feature flags (all off in V1)
NEXT_PUBLIC_ENABLE_OCR=
NEXT_PUBLIC_ENABLE_QBO=
NEXT_PUBLIC_ENABLE_OFX=
NEXT_PUBLIC_ENABLE_BANK_SPECIFIC_CLAIMS=
